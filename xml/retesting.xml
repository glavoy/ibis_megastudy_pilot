<?xml version = '1.0' encoding = 'utf-8'?>
<survey>


	<question type = 'automatic' fieldname = 'starttime' fieldtype = 'datetime'>
	</question>


	<question type = 'radio' fieldname = 'countrycode' fieldtype = 'integer'>
		<text>Select The country/region</text>
		<responses>
			<response value = '1'>Uganda</response>
			<response value = '2'>Kenya</response>
		</responses>
	</question>


	<question type = 'automatic' fieldname = 'subjid' fieldtype = 'text'>
		<maxCharacters>20</maxCharacters>
	</question>


	<question type = 'automatic' fieldname = 'participants_name' fieldtype = 'text'>
		<maxCharacters>80</maxCharacters>
	</question>


	<question type = 'text' fieldname = 'tabletnum' fieldtype = 'text_integer'>
		<text>Please enter the tablet number of the tablet you are using</text>
		<maxCharacters>2</maxCharacters>
	</question>


	<question type = 'text' fieldname = 'interviewer_id' fieldtype = 'text_integer'>
		<text>Please enter the Interviewer ID that has been assigned to you</text>
		<maxCharacters>2</maxCharacters>
	</question>


	<question type = 'radio' fieldname = 'health_facility_ke' fieldtype = 'integer'>
		<text>Health facility name</text>
		<responses>
			<response value = '21'>Homa Bay Teaching and Referral Hospital</response>
			<response value = '22'>Rachuonyo District Hospital</response>
			<response value = '23'>Suba District Hospital</response>
			<response value = '24'>Ndhiwa District Hospital</response>
			<response value = '99'>Other</response>
		</responses>
		<preskip>
			<skip fieldname='countrycode' condition = '&lt;&gt;' response='2' response_type='fixed' skiptofieldname ='health_facility_ug'></skip>
		</preskip>
		<postskip>
			<skip fieldname='health_facility_ke' condition = '&lt;&gt;' response='99' response_type='fixed' skiptofieldname ='health_facility'></skip>
			<skip fieldname='health_facility_ke' condition = '=' response='99' response_type='fixed' skiptofieldname ='health_facility_oth'></skip>
		</postskip>
	</question>


	<question type = 'radio' fieldname = 'health_facility_ug' fieldtype = 'integer'>
		<text>Health facility name</text>
		<responses>
			<response value = '11'>Bushenyi HCIV</response>
			<response value = '12'>Ishaka Adventist Hospital (Bushenyi)</response>
			<response value = '13'>Ishongororo HCIV (Ibanda)</response>
			<response value = '14'>Ruhoko HCIV (Ibanda)</response>
			<response value = '99'>Other</response>
		</responses>
		<postskip>
			<skip fieldname='health_facility_ug' condition = '&lt;&gt;' response='99' response_type='fixed' skiptofieldname ='health_facility'></skip>
			<skip fieldname='health_facility_ug' condition = '=' response='99' response_type='fixed' skiptofieldname ='health_facility_oth'></skip>
		</postskip>
	</question>


	<question type = 'text' fieldname = 'health_facility_oth' fieldtype = 'text'>
		<text>Specify other health facility</text>
		<maxCharacters>80</maxCharacters>
	</question>


	<question type = 'automatic' fieldname = 'health_facility' fieldtype = 'integer'>
	</question>


	<question type = 'checkbox' fieldname = 'qc_source' fieldtype = 'text'>
		<text>QC source</text>
		<responses>
			<response value = '1'>EMR</response>
			<response value = '2'>Self Report</response>
			<response value = '3'>Manual Records Review</response>
			<response value = '4'>Database Comparison</response>
		</responses>
		<postskip>
			<skip fieldname='qc_source' condition = 'does not contain' response='2' response_type='fixed' skiptofieldname ='hadfu_visit'></skip>
		</postskip>
	</question>


	<question type = 'radio' fieldname = 'selfreport_phonecall_reached' fieldtype = 'integer'>
		<text>Was participant reached by phone within 3 attempts (at separate times)?</text>
		<responses>
			<response value = '1'>Yes</response>
			<response value = '2'>No (Participant could not be reached)</response>
		</responses>
		<postskip>
			<skip fieldname='selfreport_phonecall_reached' condition = '&lt;&gt;' response='1' response_type='fixed' skiptofieldname ='selfreport_sampled_qc'></skip>
		</postskip>
	</question>


	<question type = 'radio' fieldname = 'selfreport_hadfu_visit' fieldtype = 'integer'>
		<text>Did the participant report retesting at this clinic within 3-6 mo from BL?</text>
		<responses>
			<response value = '1'>Yes</response>
			<response value = '2'>No</response>
		</responses>
		<postskip>
			<skip fieldname='selfreport_hadfu_visit' condition = '=' response='2' response_type='fixed' skiptofieldname ='comments'></skip>
		</postskip>
	</question>


	<question type = 'text' fieldname = 'selfreport_retest_date' fieldtype = 'text'>
		<text>What was the date of the test as reported by the Participant?</text>
		<maxCharacters>30</maxCharacters>
	</question>


	<question type = 'radio' fieldname = 'selfreport_retest_loc' fieldtype = 'integer'>
		<text>Where was the participant tested (Current Clinic/other Clinic)</text>
		<responses>
			<response value = '1'>Current Clinic - OPD</response>
			<response value = '2'>Current Clinic - MCH</response>
			<response value = '3'>Current Clinic - Outreach</response>
			<response value = '4'>Current Clinic - CCC/VCT</response>
			<response value = '5'>Current Clinic - Other</response>
			<response value = '99'>Other Clinic</response>
		</responses>
	</question>


	<question type = 'text' fieldname = 'selfreport_oth_loc' fieldtype = 'text'>
		<text>Specify other health facility</text>
		<maxCharacters>80</maxCharacters>
		<preskip>
			<skip fieldname='selfreport_retest_loc' condition = '&lt;&gt;' response='99' response_type='fixed' skiptofieldname ='selfreport_retest_results'></skip>
		</preskip>
	</question>


	<question type = 'radio' fieldname = 'selfreport_retest_results' fieldtype = 'integer'>
		<text>What was the result of the test as reported by the participant? (positive/negative/indeterminate)?</text>
		<responses>
			<response value = '0'>Negative</response>
			<response value = '1'>Positive</response>
			<response value = '2'>Indeterminate</response>
		</responses>
	</question>


	<question type = 'radio' fieldname = 'selfreport_sampled_qc' fieldtype = 'integer'>
		<text>Was this case reviewed in the registers? (sampling approach)</text>
		<responses>
			<response value = '1'>Yes</response>
			<response value = '2'>No</response>
		</responses>
		<preskip>
			<skip fieldname='selfreport_phonecall_reached' condition = '&lt;&gt;' response='2' response_type='fixed' skiptofieldname ='hadfu_visit'></skip>
		</preskip>
		<postskip>
			<skip fieldname='selfreport_sampled_qc' condition = '&lt;&gt;' response='1' response_type='fixed' skiptofieldname ='comments'></skip>
		</postskip>
	</question>


	<question type = 'radio' fieldname = 'hadfu_visit' fieldtype = 'integer'>
		<text>Did this participant return to clinic for HIV retesting within 3-6 months from baseline? (Confirmed/found in EMR/Registers)</text>
		<responses>
			<response value = '1'>Yes</response>
			<response value = '2'>No</response>
		</responses>
		<postskip>
			<skip fieldname='hadfu_visit' condition = '&lt;&gt;' response='1' response_type='fixed' skiptofieldname ='comments'></skip>
		</postskip>
	</question>


	<question type = 'date' fieldname = 'fu_visit_date' fieldtype = 'datetime'>
		<text>What was the date of the test?</text>
	</question>


	<question type = 'radio' fieldname = 'hivtest_result' fieldtype = 'integer'>
		<text>What was the result of the test? (positive/negative/indeterminate)?</text>
		<responses>
			<response value = '0'>Negative</response>
			<response value = '1'>Positive</response>
			<response value = '2'>Indeterminate</response>
		</responses>
	</question>


	<question type = 'text' fieldname = 'comments' fieldtype = 'text'>
		<text>Use this field to record any special comments/info/problems</text>
		<maxCharacters>255</maxCharacters>
		<na>-6</na>
	</question>


	<question type = 'automatic' fieldname = 'uniqueid' fieldtype = 'text'>
	</question>


	<question type = 'automatic' fieldname = 'swver' fieldtype = 'text'>
	</question>


	<question type = 'automatic' fieldname = 'stoptime' fieldtype = 'datetime'>
	</question>


	<question type = 'information' fieldname = 'end_of_questions' fieldtype = 'n/a'>
		<text>Press the 'Next' button to save the data.</text >
	</question>


</survey>
